{
	"doctype": "DocType",
	"name": "Gym Member",
	"module": "Gym Membership",
	"custom": 0,
	"is_submittable": 0,
	"editable_grid": 1,
	"engine": "InnoDB",
	"field_order": [
		"member_name",
		"gender",
		"date_of_birth",
		"email",
		"phone",
		"status"
	],
	"fields": [
		{
			"fieldname": "member_name",
			"fieldtype": "Data",
			"in_list_view": 1,
			"label": "Member Name",
			"reqd": 1
		},
		{
			"fieldname": "gender",
			"fieldtype": "Select",
			"label": "Gender",
			"options": "Male\nFemale\nOther"
		},
		{
			"fieldname": "date_of_birth",
			"fieldtype": "Date",
			"label": "Date of Birth"
		},
		{
			"fieldname": "email",
			"fieldtype": "Data",
			"options": "Email",
			"label": "Email"
		},
		{
			"fieldname": "phone",
			"fieldtype": "Data",
			"options": "Phone",
			"label": "Phone"
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"in_list_view": 1,
			"label": "Status",
			"options": "Active\nInactive\nSuspended",
			"default": "Active"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"submit": 0,
			"cancel": 0,
			"amend": 0
		}
	]
}